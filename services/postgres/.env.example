# PostgreSQL 初始化变量
# 部署前执行：cp .env.example .env
#
# 重要：以下变量只在 data/postgres 为空、首次初始化时生效。
#      数据目录已有内容时，改这里不会改掉已有密码。

# 超级用户 postgres 的密码。仅用于管理，业务服务不该用它。
POSTGRES_PASSWORD=change-me

# 首次初始化时自动创建的业务库
POSTGRES_DB=app

# 业务账号 app 的密码，由 initdb/01-app-role.sh 创建该角色时使用。
# 这个账号只能连 POSTGRES_DB 并在 public schema 里建表，没有超级用户权限。
APP_PASSWORD=change-me-too

# 时区：影响日志时间戳与 now()
TZ=Asia/Shanghai
